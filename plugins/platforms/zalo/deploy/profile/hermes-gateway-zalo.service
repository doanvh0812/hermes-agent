# Gateway process bound to the zalo-bot profile -- the `systemctl --user`
# variant, for a shared or desktop machine where the bot runs as a login user.
#
# FOR A DEDICATED SERVER, USE deploy/migrate/systemd/ INSTEAD. Those are
# SYSTEM units and they are what the migration installs. A user unit needs
# `loginctl enable-linger` or it stops with the last login session and never
# comes back at boot. They also set StartLimitIntervalSec=0, which this one
# does not: systemd otherwise gives up after 5 restarts in 10 seconds.
#
# Two unit files for one job is a drift risk, so: this file is the fallback,
# deploy/migrate/systemd/ is production. Change both or neither.
#
# A gateway serves exactly one profile, resolved from HERMES_HOME at startup.
# HERMES_HOME whose immediate parent is named "profiles" selects that profile;
# pointing it at the hermes root runs the default profile instead.
#
# Install to: ~/.config/systemd/user/hermes-gateway-zalo.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now hermes-gateway-zalo

[Unit]
Description=Hermes Gateway (zalo-bot profile, read-only Odoo support)
After=network-online.target

[Service]
Type=simple
Environment="HERMES_HOME=%h/.hermes/profiles/zalo-bot"
# uvx (the MCP server launcher) usually lives in ~/.local/bin, which systemd
# user units do NOT inherit — without it the Odoo MCP server never starts.
Environment="PATH=%h/.hermes/hermes-agent/venv/bin:%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=%h/.hermes/hermes-agent
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
