# Reverse proxy with automatic HTTPS for the Zalo admin panel.
#
# Caddy is used rather than nginx because it obtains and renews a Let's Encrypt
# certificate on its own — no certbot, no renewal cron, no scheduled task to
# forget. On Windows that difference matters more than it does on Linux.
#
#   winget install CaddyServer.Caddy
#   caddy run --config C:\path\to\Caddyfile
#   caddy start   (background)  /  caddy stop
#
# BEFORE THIS WORKS
#   1. An A record for the name below must point at THIS host, unproxied.
#      Verify against the zone's AUTHORITATIVE nameserver, not a public
#      resolver: a wildcard record or a CDN proxy will happily answer for a
#      name you never created, and the certificate request then goes to the
#      wrong origin. Compare the answer for a deliberately fake subdomain --
#      if it matches, you are looking at a wildcard, not your record.
#   2. Inbound TCP 80 and 443 open, on the Windows firewall AND the provider's.
#      Caddy chooses the challenge itself (this deployment ended up on
#      tls-alpn-01 over 443), but keep 80 open: it is the fallback and it
#      serves the HTTP->HTTPS redirect.
#   3. The admin panel must be running on 127.0.0.1:8648.
#
# TEST WITH THE STAGING CA FIRST. Let's Encrypt allows only 5 failed
# validations per hostname per hour, and a DNS record pointing at the wrong
# origin burns them before you can fix it. Add this inside the site block:
#
#     tls { ca https://acme-staging-v02.api.letsencrypt.org/directory }
#
# Remove it once the log says "certificate obtained successfully", then
# restart to fetch the real one.
#
# The admin process itself refuses to bind anything but loopback, so this proxy
# is the only way in — TLS is never optional by accident.

zalo-admin.vniedu.vn {
	encode zstd gzip

	# Caddy sets X-Forwarded-Proto/-Host automatically. The panel reads them to
	# decide whether to mark the session cookie Secure and to build the QR
	# share link against the public origin instead of the bridge's port.
	reverse_proxy 127.0.0.1:8648

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		-Server
	}

	log {
		output file C:\Users\Administrator\AppData\Local\hermes\profiles\zalo-bot\logs\caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Optional hardening once it works: restrict to the office egress IP so a
# stolen password is not enough on its own. Replace with your real range.
#
# zalo-admin.vniedu.vn {
# 	@notoffice not remote_ip 203.0.113.0/24
# 	respond @notoffice 403
# 	reverse_proxy 127.0.0.1:8648
# }
